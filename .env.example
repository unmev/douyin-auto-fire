# 抖音认证配置（二选一）
# Cookie 数组 JSON 或文件路径
DOUYIN_COOKIE=cookie.json
# 或使用 Storage State（推荐 Windows 用户）
# DOUYIN_STORAGE_STATE=storage-state.json

# 任务配置文件路径
TASK_CONFIG=config.json

# 产物输出目录
ARTIFACTS_DIR=artifacts

# 浏览器配置
HEADLESS=false
# BROWSER_PATH=/usr/bin/chromium

# Playwright Trace（失败诊断）
TRACE=true

# 钉钉机器人通知（可选，需同时配置）
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET=SECxxx

# 通用 Webhook 通知（可选）
# Webhook URL
# WEBHOOK_URL=https://example.com/webhook

# 自定义请求头（可选）
# 支持 JSON 格式: {"Authorization": "Bearer token", "X-Custom": "value"}
# 或键值对格式: Authorization=Bearer token,X-Custom=value
# WEBHOOK_HEADERS={"Content-Type": "application/json"}

# 自定义 JSON 模板（可选）
# 支持变量: {task_id}, {mode}, {status}, {success_count}, {failed_count}, {total_count}, {timestamp}, {results_json}
# WEBHOOK_TEMPLATE={"text": "任务 {task_id} 完成", "status": "{status}", "success": {success_count}, "failed": {failed_count}}

# 系统登录与自动化凭据（可选，未设置时首次启动交互式引导初始化与登录）
# APP_AUTH_USERNAME=admin
# APP_AUTH_PASSWORD=YourSecurePassword123
